@startuml sequence_multi_class
skinparam maxMessageSize 150
actor "Source\n(Источник)" as Source
participant "DispatcherPut\n(Диспетчер постановки)" as DPut
participant "Buffer\n(Буфер)" as Buffer
participant "DispatcherGet\n(Диспетчер выборки)" as DGet
participant "Device\n(Прибор)" as Device

== Поступление заявки (Событие генерации по ИЗ2) ==

Source -> DPut: processNewRequest(req)
activate DPut

DPut -> Buffer: isFull()
activate Buffer
Buffer -->> DPut: статус: места есть / мест нет
deactivate Buffer

alt Буфер не переполнен (Свободные места)
    DPut -> Buffer: insertAtFirstFreeSpot(req) [Д1ОЗ3]
    activate Buffer
    Buffer -->> DPut: Заявка сохранена без сдвига
    deactivate Buffer
else Буфер заполнен на 100%
    DPut -> Buffer: Запрос приоритетов заявок
    activate Buffer
    Buffer -->> DPut: Данные о заявках
    deactivate Buffer

    alt Приоритет новой заявки <= худшего в буфере
        DPut -> DPut: Отказ новой заявке\n(dropped_counters++)
    else Новая заявка приоритетнее
        DPut -> Buffer: removeLowestPriorityRequest() [Д1ОО2]
        activate Buffer
        Buffer -->> DPut: Самая старая заявка с худшим приоритетом удалена (Отказ)
        deactivate Buffer

        DPut -> Buffer: insertAtFirstFreeSpot(req) [Д1ОЗ3]
        activate Buffer
        Buffer -->> DPut: Заявка заняла освободившуюся ячейку
        deactivate Buffer
    end
end
deactivate DPut

== Выборка на обслуживание (Событие освобождения прибора по ПЗ1) ==

Device -> DGet: onDeviceFreed()
activate DGet

DGet -> Buffer: isEmpty()
activate Buffer
Buffer -->> DGet: статус: пуст / не пуст
deactivate Buffer

alt В буфере есть ожидающие заявки
    DGet -> Buffer: Запросить список доступных источников
    activate Buffer
    Buffer -->> DGet: Список ID источников
    deactivate Buffer

    DGet -> DGet: Определить приоритетный\nисточник для пакета [Д2Б5]

    loop Пока есть заявки в активном пакете
        DGet -> Buffer: Извлечь самую старую заявку\nактивного пакета
        activate Buffer
        Buffer -->> DGet: req (данные заявки)
        deactivate Buffer

        DGet -> DGet: getNextDeviceByRing()\nСдвиг указателя [Д2П2]

        DGet -> Device: process(req)
        activate Device
        Device -->> DGet: Подтверждение (Прибор перешел в статус "Занят")
        deactivate Device
    end
else Буфер пуст
    DGet -> DGet: Переход в режим ожидания\nновых событий
end
deactivate DGet

@enduml