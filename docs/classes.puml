@startuml classes_multi_class
skinparam classAttributeIconSize 0

class Request {
  - sourceId: int
  - generationTime: float
  + getSourceId(): int
  + getGenerationTime(): float
}

class Source {
  - sourceId: int
  + generateRequest(): void
}

class Buffer {
  - capacity: int
  - queue: Request[]
  + isFull(): boolean
  + isEmpty(): boolean
  + insertAtFirstFreeSpot(req: Request): void
  + removeLowestPriorityRequest(): Request
  + getAvailableSources(): int[]
  + extractOldestFromPackage(sourceId: int): Request
}

class DispatcherPut {
  - buffer: Buffer
  + processNewRequest(req: Request): void
}

class DispatcherGet {
  - buffer: Buffer
  - devices: Device[]
  - devicePointer: int
  - activePackageSource: int
  + onDeviceFreed(): void
  - getNextDeviceByRing(): Device
}

class Device {
  - deviceId: int
  - isBusy: boolean
  - dispatcherGet: DispatcherGet
  + process(req: Request): void
}

Source --> DispatcherPut : "вызывает processNewRequest()"
DispatcherPut --> Buffer : "- buffer"
DispatcherGet --> Buffer : "- buffer"
DispatcherGet --> Device : "- devices"
Device --> DispatcherGet : "оповещает onDeviceFreed()"
Buffer o-- Request : "Хранит"

@enduml