@startuml flowchart
|Источник|
start
:Генерация заявки (ИЗ2);

|Диспетчер постановки|
if (Буфер переполнен?) then (Да)
  :Найти заявку с наименьшим\nприоритетом источника (Д1ОО2);
  |Буфер|
  :Удалить найденную заявку\n(Отказ);
else (Нет)
endif

|Диспетчер постановки|
:Поместить новую заявку на\nпервое свободное место (Д1ОЗ3);
|Буфер|
:Заявка ожидает в очереди;

|Прибор|
:Окончание обслуживания\n(ПЗ1);

|Диспетчер выборки|
if (Буфер пуст?) then (Да)
  stop
else (Нет)
  :Найти самый приоритетный пакет\nзаявок одного источника (Д2Б5);
  repeat
    :Извлечь следующую\nзаявку из пакета;
    :Найти свободный прибор\nциклически по кольцу (Д2П2);
    |Прибор|
    :Начать обслуживание;
  |Диспетчер выборки|
  repeat while (Есть еще заявки в пакете?) is (Да)
endif
stop
@enduml